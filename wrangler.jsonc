{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cn-memes-abroad-web",
  "compatibility_date": "2026-08-16",
  "routes": [
    {
      "pattern": "tudu-stickers.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
