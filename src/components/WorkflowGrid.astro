---
import { Icon } from "astro-icon/components";
const steps = [
  { icon: "ph:folder-simple-plus", title: "导入", body: "从微信或本机导入，支持单条或批量文件。" },
  { icon: "ph:plugs-connected", title: "连接", body: "连接到 WhatsApp 等应用，让表情自然出海。" },
  { icon: "ph:tag", title: "整理", body: "分组收藏，统一命名，建立自己的梗图库。" },
  { icon: "ph:export", title: "导出", body: "一键导出到目标应用，也可保存到本地。" },
];
---
<section id="workflow" class="workflow" aria-labelledby="workflow-title">
  <div class="page-shell workflow-shell"><h2 id="workflow-title" class="visually-hidden">使用流程</h2><div class="workflow-grid">
    {steps.map((step, index) => <>
      <article class="workflow-step"><span class="step-index">0{index + 1}</span><span class="step-icon-stack" aria-hidden="true"><Icon class="step-icon step-icon-echo" name={step.icon} size={64} /><Icon class="step-icon" name={step.icon} size={64} /></span><div><h3>{step.title}</h3><p>{step.body}</p></div></article>
      {index < steps.length - 1 && <Icon class="flow-arrow" name="ph:arrow-right" size={34} aria-hidden="true" />}
    </>)}
  </div></div>
</section>
<style>
  .workflow { position: relative; border-bottom: 1px solid var(--line); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .workflow-shell { padding-block: clamp(2.25rem, 4vw, 4.5rem); }
  .workflow-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; }
  .workflow-step { position: relative; display: grid; min-width: 0; min-height: 250px; grid-template-rows: auto auto 1fr; align-content: start; justify-items: start; padding: 1rem clamp(.85rem, 1.7vw, 1.55rem); }
  .workflow-step::after { position: absolute; right: 8%; bottom: .45rem; left: 8%; height: 1px; content: ""; border-bottom: 1px dashed color-mix(in srgb, var(--ink) 34%, transparent); transform: rotate(var(--rule-tilt, -.5deg)); }
  .workflow-step:nth-of-type(even) { --rule-tilt: .65deg; }
  .step-index { color: var(--accent); font-family: ui-monospace, "SFMono-Regular", Consolas, monospace; font-size: clamp(2.2rem, 3.6vw, 3.7rem); font-weight: 900; line-height: .9; letter-spacing: -.11em; transform: rotate(-2deg); }
  .step-icon-stack { position: relative; display: grid; width: 64px; height: 64px; margin: .95rem 0 .8rem; place-items: center; }
  .step-icon { grid-area: 1 / 1; stroke-width: 1.4; transform: rotate(var(--icon-tilt, -2deg)); }
  .step-icon-echo { opacity: .16; transform: translate(2px, -1px) rotate(var(--icon-tilt, -2deg)); }
  .workflow-step:nth-of-type(even) .step-icon { --icon-tilt: 2deg; }
  .workflow-step h3 { width: fit-content; margin: 0 0 .55rem; font-size: 1.4rem; line-height: 1.1; letter-spacing: -.04em; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 7px; }
  .workflow-step p { max-width: 15rem; margin: 0; color: var(--ink-soft); font-size: .94rem; line-height: 1.62; }
  .flow-arrow { color: var(--accent); transform: rotate(var(--arrow-tilt, -5deg)); }
  .flow-arrow:nth-of-type(even) { --arrow-tilt: 5deg; }
  @media (max-width: 1023px) {
    .workflow-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .workflow-step { min-height: 230px; border-bottom: 1px dashed var(--line-strong); }
    .flow-arrow { display: none; }
  }
  @media (max-width: 560px) {
    .workflow-shell { padding-block: 2rem 3rem; }
    .workflow-grid { grid-template-columns: minmax(0, 1fr); }
    .workflow-step { min-height: 0; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 1.15rem; padding-block: 1.35rem 1.8rem; }
    .step-index { grid-row: 1 / span 2; font-size: 2.4rem; }
    .step-icon-stack { grid-column: 2; margin: 0 0 .75rem; }
    .workflow-step > div { grid-column: 2; }
  }
</style>
