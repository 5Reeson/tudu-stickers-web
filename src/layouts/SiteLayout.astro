---
import { css as displayFont } from "@/assets/fonts/smiley-sans/SmileySans-Oblique.ttf?subsets";
import { downloads, releaseVersion } from "@/config/downloads";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = "/",
  ogImage = "/og/home-temporary.png",
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? Astro.url);
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url);
const siteUrl = new URL("/", Astro.site ?? Astro.url);
const logoUrl = new URL("/brand/tudu-logo-v2/tudu-logo-512.png", Astro.site ?? Astro.url);
const isHomePage = canonicalPath === "/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "图渡",
      alternateName: ["TuDu", "TuduStickers", "TuDu Stickers", "tudu-stickers.com"],
      description,
      inLanguage: "zh-CN",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}#software`,
      url: siteUrl,
      name: "图渡 TuDu",
      alternateName: ["图渡", "TuduStickers", "TuDu Stickers"],
      description,
      applicationCategory: "UtilitiesApplication",
      applicationSubCategory: "表情包导出工具",
      operatingSystem: "macOS",
      softwareVersion: releaseVersion,
      image: ogImageUrl,
      logo: logoUrl,
      downloadUrl: [downloads.arm64.url, downloads.x64.url],
      isAccessibleForFree: true,
      featureList: [
        "导出微信表情包",
        "一键保存表情包到本地",
        "导入表情包到 WhatsApp、飞书和钉钉等应用",
        "图片在本地处理",
      ],
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "CNY",
        availability: "https://schema.org/InStock",
      },
      sameAs: ["https://github.com/5Reeson/tudu-stickers"],
      isPartOf: { "@id": `${siteUrl}#website` },
    },
  ],
};
const displayFontStack = `"${displayFont.family}", "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", system-ui, sans-serif`;
---

<!doctype html>
<html lang="zh-CN" style={`--font-display: ${displayFontStack};`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/tudu-logo-v2/tudu-logo-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/tudu-logo-v2/tudu-logo-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/tudu-logo-v2/tudu-logo-180.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="图渡" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    {isHomePage && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body><slot /></body>
</html>
