---
import DownloadCta from "@/components/DownloadCta.astro";
import FaqSection from "@/components/FaqSection.astro";
import Hero from "@/components/Hero.astro";
import SectionDivider from "@/components/SectionDivider.astro";
import SecuritySection from "@/components/SecuritySection.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import TrustStrip from "@/components/TrustStrip.astro";
import WorkflowGrid from "@/components/WorkflowGrid.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
const title = "图渡 TuDu - 导出微信表情包";
const description = "图渡 TuduStickers 可以帮你导出微信表情包，可以一键保存到本地，更支持一键导入 WhatsApp 或飞书、钉钉等其他办公应用。";
---
<SiteLayout title={title} description={description}>
  <SiteHeader />
  <main>
    <Hero />
    <TrustStrip />
    <SectionDivider />
    <WorkflowGrid />
    <SectionDivider />
    <SecuritySection />
    <!-- FeatureDetails 暂时隐藏，组件文件保留以便后续恢复。 -->
    <SectionDivider />
    <FaqSection />
    <SectionDivider />
    <DownloadCta />
  </main>
  <SiteFooter />
</SiteLayout>
