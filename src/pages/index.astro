---
import DownloadCta from "@/components/DownloadCta.astro";
import FaqSection from "@/components/FaqSection.astro";
import Hero from "@/components/Hero.astro";
import SectionDivider from "@/components/SectionDivider.astro";
import SecuritySection from "@/components/SecuritySection.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import TrustStrip from "@/components/TrustStrip.astro";
import WorkflowGrid from "@/components/WorkflowGrid.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
const title = "图渡 | 让表情包和你一起渡洋出海";
const description = "在 Mac 上把微信表情轻松导出到 WhatsApp 或保存到本地本地。素材全程本地处理。";
---
<SiteLayout title={title} description={description}>
  <SiteHeader />
  <main>
    <Hero />
    <TrustStrip />
    <SectionDivider />
    <WorkflowGrid />
    <SectionDivider />
    <SecuritySection />
    <!-- FeatureDetails 暂时隐藏，组件文件保留以便后续恢复。 -->
    <SectionDivider />
    <FaqSection />
    <SectionDivider />
    <DownloadCta />
  </main>
  <SiteFooter />
</SiteLayout>
